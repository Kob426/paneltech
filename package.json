{
  "name": "paneltech-marking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "demo": "npm run build && tsx server/index.ts",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "python tests/browser_smoke.py"
  },
  "dependencies": {
    "express": "5.3.0",
    "vue": "3.5.44",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.7",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.2.5"
  }
}
