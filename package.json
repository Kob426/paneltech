{
  "name": "paneltech-marking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "setup:owner": "tsx scripts/setup-owner.ts",
    "local": "npm run build && tsx server/index.ts --local",
    "demo": "npm run build && tsx server/index.ts",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "python3 tests/browser_smoke.py && python3 tests/browser_admin.py && python3 tests/browser_users.py && python3 tests/browser_workspace.py && python3 tests/browser_pages.py && python3 tests/browser_audit.py && python3 tests/browser_device_access.py && python3 tests/browser_operations.py",
    "db:backup": "tsx scripts/database.ts backup",
    "db:verify": "tsx scripts/database.ts verify",
    "db:restore": "tsx scripts/database.ts restore",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:check": "tsx scripts/database.ts check",
    "test:database": "python3 tests/database_smoke.py",
    "db:stats": "tsx scripts/database.ts stats",
    "db:compact": "tsx scripts/database.ts compact",
    "measure:storage": "tsx scripts/measure-storage.ts",
    "measure:load": "python3 scripts/measure-load.py",
    "measure:soak": "python3 scripts/measure-soak.py",
    "test:operations": "python3 tests/operations_smoke.py",
    "measure:operations-load": "python3 scripts/measure-operations-load.py"
  },
  "dependencies": {
    "express": "5.3.0",
    "vue": "3.5.44",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.7",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.2.5"
  }
}
